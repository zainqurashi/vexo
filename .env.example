# ═══════════════════════════════════════════════════════════════════════
# VEXO — Smart Kitchen & Home Gadgets Headless Storefront (.env.example)
# Domain: vexohome.store
# ═══════════════════════════════════════════════════════════════════════
#
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
#
# 2. In Shopify Admin -> Settings -> Apps and sales channels -> Develop apps:
#    - Create or select a custom app (e.g. "Vexo Storefront")
#    - Under "Configuration" -> "Storefront API integration", grant:
#      - unauthenticated_read_product_listings
#      - unauthenticated_read_product_inventory
#      - unauthenticated_read_checkouts
#      - unauthenticated_write_checkouts
#      - unauthenticated_read_customers
#    - Install the app and copy your public Storefront API access token below.
#
# 3. For Vercel deployment, add these same variables under Project Settings -> Environment Variables.

# Your Shopify store domain (e.g., yourstore.myshopify.com)
VITE_SHOPIFY_STORE_DOMAIN=vexohome.myshopify.com

# Shopify Storefront API Public Access Token
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token_here

# Shopify Storefront API Version (Stable)
VITE_SHOPIFY_API_VERSION=2024-01

# Public Store Brand Settings
VITE_BRAND_NAME=Vexo
VITE_BRAND_TAGLINE=Smart Living. Beautiful Spaces.
VITE_FREE_SHIPPING_THRESHOLD=150
